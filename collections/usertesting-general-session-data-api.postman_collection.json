  "info": {
    "_postman_id": "34949973-754b-4354-91b7-fa6640ccece7",
    "name": "Results General Session Data API",
    "description": "With the Results API, you can access the results of your UserTesting account's Surveys, Live Conversations, Interaction Tests, and Think-out-loud Tests for analysis and reporting purposes.\n\nContact Support:\n Name: UserTesting Support\n Email: support@usertesting.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T20:17:05.000Z",
    "updatedAt": "2026-10-21T20:17:06.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-34949973-754b-4354-91b7-fa6640ccece7"
  },
