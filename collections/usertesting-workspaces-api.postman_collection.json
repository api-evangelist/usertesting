                        "{{baseUrl}}"
                      ],
                      "path": [
                        "v1",
                        "workspaces",
                        ":workspaceUuid"
                      ],
                      "query": [
                        {
                          "description": "Cursor for paginating through study results. Use the `cursor` value from a previous response to retrieve the next 50 results following the indicated study.",
                          "key": "after",
                          "value": "<string>"
