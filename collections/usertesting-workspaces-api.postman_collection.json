                        {
                          "id": "0f3d08cc-c131-41c8-a60e-baea20afd092",
                          "key": "workspaceUuid",
                          "value": "<string>",
                          "description": "(Required) The UUID of the workspace you want to obtain information for. You can obtain this UUID by querying the [Get Workspaces endpoint](https://developer.usertesting.com/v1.0_test/reference/get_v1-workspaces)."
                        }
                      ]
                    },
                    "description": "Fetch all studies (tests) in a workspace identified by UUID. Returns summary information for each study including title, UUID, creation date, and the user who created it. The response returns up to 50 studies per page. Use pagination with cursor for large workspaces.\n\n**Note**: When using this endpoint to retrieve v2 compatible studies, keep in mind that _studies_ are referred to as _tests_ in both the UserTesting Platform and in the v2 API."
