      "item": [
        {
          "id": "8ab9cb11-1d41-4393-b37e-bfda3c5ca27d",
          "name": "List studies in a workspace",
          "request": {
            "name": "List studies in a workspace",
            "description": {
              "content": "Fetch all studies (tests) in a workspace identified by UUID. Returns summary information for each study including title, UUID, creation date, and the user who created it. The response returns up to 50 studies per page. Use pagination with cursor for large workspaces.\n\n**Note**: When using this endpoint to retrieve v2 compatible studies, keep in mind that _studies_ are referred to as _tests_ in both the UserTesting Platform and in the v2 API.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "workspaces",
                ":workspaceUuid"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<string>",
                  "description": "Cursor for paginating through study results. Use the `cursor` value from a previous response to retrieve the next 50 results following the indicated study."
                },
                {
                  "disabled": false,
                  "key": "before",
                  "value": "<string>",
                  "description": "Cursor for paginating through study results. Use the `cursor` value from a previous response to retrieve the 50 results preceding the indicated study."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspaceUuid",
                  "description": "(Required) The UUID of the workspace you want to obtain information for. You can obtain this UUID by querying the [Get Workspaces endpoint](https://developer.usertesting.com/v1.0_test/reference/get_v1-workspaces)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
